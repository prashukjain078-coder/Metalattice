  <!-- ==========================================================================
       5. HOW IT WORKS (3-step timeline section)
       ========================================================================== -->
  <section class="section" id="how-it-works" style="background: rgba(4, 5, 8, 0.6);">
    <div class="container">
      <div class="section-header fade-in-element">
        <div class="eyebrow">
          <i class="fa-solid fa-route"></i>
          Predictable Workflow
        </div>
        <h2 class="section-title">From Concept to Print-Ready Geometry</h2>
        <p class="section-subtitle">
          Transform manual sketch-and-fail iterations into a streamlined algorithmic pipeline in three deterministic steps.
        </p>
      </div>

      <div class="timeline-container">
        <!-- Connecting Line -->
        <div class="timeline-connector"></div>

        <!-- Step 1 -->
        <div class="glass-card timeline-card fade-in-element">
          <div class="timeline-header">
            <div class="step-badge">01</div>
            <span class="step-status-chip">Step 1: Input</span>
          </div>
          <h3 class="timeline-card-title">Define Requirements</h3>
          <p class="timeline-card-desc">
            Set geometry, material bounds, and performance constraints in plain language or procedural nodes without manual meshing prep.
          </p>
          <div class="tech-code-box">
            <span class="code-highlight">// Parametric Input Constraint</span><br>
            target_mass: <span class="code-purple">&lt;= 1.85 kg</span><br>
            boundary_step: <span class="code-green">"aero_pylon_v4.step"</span><br>
            min_stiffness: <span class="code-purple">24.5 kN/mm</span><br>
            flow_delta_p: <span class="code-purple">&lt; 12.0 kPa</span>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="glass-card timeline-card fade-in-element">
          <div class="timeline-header">
            <div class="step-badge step-2">02</div>
            <span class="step-status-chip">Step 2: Synthesize</span>
          </div>
          <h3 class="timeline-card-title">Generate & Optimize</h3>
          <p class="timeline-card-desc">
            AI explores design space with physics-in-the-loop, generating functional TPMS and lattice variations optimized for your manufacturing process.
          </p>
          <div class="tech-code-box">
            <span class="code-highlight">&gt; Executing GPU Field Solver...</span><br>
            surrogate_eval: <span class="code-green">4,200 variants</span><br>
            stress_peak: <span class="code-purple">192 MPa (Safety 2.1)</span><br>
            opt_convergence: <span class="code-green">100% Validated</span>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="glass-card timeline-card fade-in-element">
          <div class="timeline-header">
            <div class="step-badge step-3">03</div>
            <span class="step-status-chip">Step 3: Export</span>
          </div>
          <h3 class="timeline-card-title">Deploy with Confidence</h3>
          <p class="timeline-card-desc">
            Export validated, manufacturing-ready geometry straight into your PLM, slice stack (CLI/CLIx), or high-precision B-Rep STEP.
          </p>
          <div class="tech-code-box">
            <span class="code-highlight">// Output Formats Ready</span><br>
            ✔ <span class="code-green">Slice Stack (.CLI / .SLC)</span><br>
            ✔ <span class="code-green">Full Exact STEP (AP242)</span><br>
            ✔ <span class="code-green">Complete FEA Audit Log.pdf</span>
          </div>
        </div>
      </div>
    </div>
  </section>

