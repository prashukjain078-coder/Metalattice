          <line x1="4" y1="26" x2="32" y2="10" stroke="url(#logo-grad-2)" stroke-width="1.8"/>
          <!-- Lattice Nodes -->
          <circle cx="18" cy="3" r="2.5" fill="#00e5ff"/>
          <circle cx="32" cy="10" r="2.5" fill="#00a8ff"/>
          <circle cx="32" cy="26" r="2.5" fill="#7c3aed"/>
          <circle cx="18" cy="33" r="2.5" fill="#00e5ff"/>
          <circle cx="4" cy="26" r="2.5" fill="#00a8ff"/>
          <circle cx="4" cy="10" r="2.5" fill="#7c3aed"/>
          <circle cx="18" cy="18" r="3.5" fill="#00e5ff" filter="url(#glow)"/>
          <defs>
            <linearGradient id="logo-grad-1" x1="4" y1="3" x2="32" y2="33" gradientUnits="userSpaceOnUse">
              <stop stop-color="#00e5ff"/>
              <stop offset="0.5" stop-color="#00a8ff"/>
              <stop offset="1" stop-color="#7c3aed"/>
            </linearGradient>
            <linearGradient id="logo-grad-2" x1="18" y1="3" x2="18" y2="33" gradientUnits="userSpaceOnUse">
              <stop stop-color="#00a8ff"/>
              <stop offset="1" stop-color="#7c3aed"/>
            </linearGradient>
            <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="2" result="blur"/>
              <feComposite in="SourceGraphic" in2="blur" operator="over"/>
            </filter>
          </defs>
