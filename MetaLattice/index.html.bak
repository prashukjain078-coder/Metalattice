<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MetaLattice | Next-Generation Computational Design & Engineering Software</title>
  <meta name="description" content="MetaLattice accelerates advanced engineering with implicit modeling, AI-driven computational design, and multiphysics optimization for additive and advanced manufacturing.">
  
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 CDN for modern tech icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <style>
    /* ==========================================================================
       1. CSS VARIABLES & BASE RESETS
       ========================================================================== */
    :root {
      --bg-dark: #07080d;
      --bg-darker: #040508;
      --bg-surface: rgba(14, 17, 28, 0.7);
      --bg-card: rgba(255, 255, 255, 0.035);
      --bg-card-hover: rgba(255, 255, 255, 0.065);
      --border-subtle: rgba(255, 255, 255, 0.09);
      --border-glow: rgba(0, 168, 255, 0.35);
      --border-glow-purple: rgba(124, 58, 237, 0.4);
      
      --accent-blue: #00a8ff;
      --accent-purple: #7c3aed;
      --accent-cyan: #00e5ff;
      --accent-emerald: #10b981;
      
      --gradient-primary: linear-gradient(135deg, #00a8ff 0%, #7c3aed 100%);
      --gradient-accent: linear-gradient(135deg, #00e5ff 0%, #00a8ff 50%, #7c3aed 100%);
      --gradient-card: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.015) 100%);
      
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      
      --container-max: 1240px;
      --transition-smooth: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      --transition-slow: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      background-color: var(--bg-dark);
      overflow-x: hidden;
      position: relative;
    }

    /* Background Ambient Mesh Light */
    body::before {
      content: "";
      position: fixed;
      top: -20%;
      left: 50%;
      transform: translateX(-50%);
      width: 1000px;
      height: 700px;
      background: radial-gradient(circle, rgba(0, 168, 255, 0.12) 0%, rgba(124, 58, 237, 0.08) 45%, transparent 70%);
      filter: blur(120px);
      z-index: -2;
      pointer-events: none;
    }

    body::after {
      content: "";
      position: fixed;
      bottom: -10%;
      right: -10%;
      width: 800px;
      height: 800px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.1) 0%, rgba(0, 229, 255, 0.05) 50%, transparent 70%);
      filter: blur(140px);
      z-index: -2;
      pointer-events: none;
    }

    /* Subtle grid lattice background pattern */
    .bg-grid-pattern {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 80%);
      pointer-events: none;
      z-index: -1;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: var(--transition-smooth);
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      outline: none;
      background: none;
    }

    img, svg {
      display: block;
      max-width: 100%;
    }

    /* Container Utility */
    .container {
      width: 100%;
      max-width: var(--container-max);
      margin-left: auto;
      margin-right: auto;
      padding-left: 2rem;
      padding-right: 2rem;
    }

    /* Section Spacing - Generous 100px vertical padding */
    .section {
      padding: 100px 0;
      position: relative;
    }

    /* Typography Utilities */
    .gradient-text {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline;
    }

    .gradient-text-cyan {
      background: linear-gradient(135deg, #00e5ff 0%, #00a8ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.07);
      border: 1px solid rgba(0, 229, 255, 0.22);
      padding: 6px 14px;
      border-radius: 9999px;
      margin-bottom: 1.25rem;
    }

    .eyebrow i {
      font-size: 0.7rem;
    }

    .section-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 4rem auto;
    }

    .section-title {
      font-size: 2.75rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.03em;
      margin-bottom: 1.25rem;
      color: #ffffff;
    }

    .section-subtitle {
      font-size: 1.125rem;
      color: var(--text-muted);
      line-height: 1.65;
    }

    /* Glassmorphism Cards */
    .glass-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-radius: 16px;
      padding: 2.25rem;
      transition: var(--transition-smooth);
      position: relative;
      overflow: hidden;
    }

    .glass-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      opacity: 0.6;
    }

    .glass-card:hover {
      transform: translateY(-6px);
      border-color: var(--border-glow);
      background: var(--bg-card-hover);
      box-shadow: 0 16px 36px -12px rgba(0, 168, 255, 0.15), 0 0 20px 1px rgba(0, 168, 255, 0.1);
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      padding: 0.85rem 1.85rem;
      font-size: 0.95rem;
      font-weight: 600;
      border-radius: 10px;
      transition: var(--transition-smooth);
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-primary {
      background: var(--gradient-primary);
      color: #ffffff;
      box-shadow: 0 0 25px rgba(0, 168, 255, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.15);
      position: relative;
      overflow: hidden;
    }

    .btn-primary::after {
      content: "";
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(60deg, transparent, rgba(255, 255, 255, 0.25), transparent);
      transform: rotate(25deg) translateY(-100%);
      transition: transform 0.75s ease;
    }

    .btn-primary:hover::after {
      transform: rotate(25deg) translateY(100%);
    }

    .btn-primary:hover {
      box-shadow: 0 0 35px rgba(0, 168, 255, 0.65), 0 0 15px rgba(124, 58, 237, 0.4);
      transform: translateY(-2px);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-main);
      border: 1px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.3);
      color: #ffffff;
      transform: translateY(-2px);
    }

    .btn-sm {
      padding: 0.6rem 1.25rem;
      font-size: 0.85rem;
      border-radius: 8px;
    }

    /* Scroll Animation Base */
    .fade-in-element {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .fade-in-element.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       2. NAVIGATION BAR
       ========================================================================== */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      padding: 1.1rem 0;
      background: rgba(7, 8, 13, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      transition: var(--transition-smooth);
    }

    .navbar.scrolled {
      padding: 0.8rem 0;
      background: rgba(7, 8, 13, 0.92);
      border-bottom-color: rgba(255, 255, 255, 0.12);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Logo */
    .nav-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.35rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.03em;
    }

    .logo-icon-svg {
      width: 32px;
      height: 32px;
      filter: drop-shadow(0 0 10px rgba(0, 168, 255, 0.6));
    }

    .nav-logo span {
      background: linear-gradient(135deg, #ffffff 40%, var(--accent-cyan) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Nav Links & Dropdowns */
    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      list-style: none;
    }

    .nav-item {
      position: relative;
    }

    .nav-link {
      font-size: 0.92rem;
      font-weight: 500;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.5rem 0;
    }

    .nav-link i.fa-chevron-down {
      font-size: 0.65rem;
      transition: transform 0.25s ease;
      color: var(--text-dim);
    }

    .nav-link:hover {
      color: #ffffff;
    }

    .nav-item:hover .nav-link i.fa-chevron-down {
      transform: rotate(180deg);
      color: var(--accent-cyan);
    }

    /* Dropdown Menu */
    .nav-dropdown {
      position: absolute;
      top: 100%;
      left: -1rem;
      width: 270px;
      background: rgba(11, 13, 23, 0.95);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 0.75rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 168, 255, 0.1);
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      list-style: none;
    }

    .nav-item:hover .nav-dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(4px);
    }

    .dropdown-link {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 0.75rem;
      border-radius: 8px;
      transition: var(--transition-smooth);
    }

    .dropdown-link:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    .dropdown-icon {
      font-size: 1rem;
      color: var(--accent-cyan);
      margin-top: 0.15rem;
      width: 20px;
      text-align: center;
    }

    .dropdown-content .dropdown-title {
      font-size: 0.88rem;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 0.15rem;
    }

    .dropdown-content .dropdown-desc {
      font-size: 0.75rem;
      color: var(--text-muted);
      line-height: 1.35;
    }

    /* Nav Actions Right */
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .nav-signin {
      font-size: 0.92rem;
      font-weight: 500;
      color: var(--text-muted);
      padding: 0.5rem 0.75rem;
    }

    .nav-signin:hover {
      color: #ffffff;
    }

    /* Mobile Hamburger */
    .mobile-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      padding: 6px;
      cursor: pointer;
    }

    .mobile-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: #ffffff;
      border-radius: 2px;
      transition: var(--transition-smooth);
    }

    /* Mobile Drawer */
    .mobile-drawer {
      display: none;
      position: fixed;
      top: 68px;
      left: 0;
      width: 100%;
      height: calc(100vh - 68px);
      background: rgba(7, 8, 13, 0.98);
      backdrop-filter: blur(25px);
      padding: 2rem;
      overflow-y: auto;
      z-index: 999;
      transform: translateX(-100%);
      transition: transform 0.35s ease-in-out;
    }

    .mobile-drawer.open {
      transform: translateX(0);
    }

    .mobile-drawer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .mobile-drawer-link {
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text-main);
      display: block;
    }

    .mobile-drawer-sublinks {
      list-style: none;
      padding-left: 1rem;
      margin-top: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .mobile-drawer-sublink {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* ==========================================================================
       3. HERO SECTION
       ========================================================================== */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 140px;
      padding-bottom: 80px;
      overflow: hidden;
    }

    /* Canvas Particle Lattice Background */
    #heroCanvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: auto;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(7, 8, 13, 0.3) 0%, rgba(7, 8, 13, 0.85) 75%, var(--bg-dark) 100%);
      z-index: 1;
      pointer-events: none;
    }

    .hero-container {
      position: relative;
      z-index: 2;
      text-align: center;
      max-width: 960px;
      margin: 0 auto;
    }

    .hero-headline {
      font-size: clamp(2.75rem, 6.5vw, 5.25rem);
      font-weight: 800;
      line-height: 1.08;
      letter-spacing: -0.04em;
      margin-bottom: 1.75rem;
      color: #ffffff;
    }

    .hero-subheadline {
      font-size: clamp(1.1rem, 2vw, 1.35rem);
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 780px;
      margin: 0 auto 2.5rem auto;
      font-weight: 400;
    }

    .hero-cta-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      flex-wrap: wrap;
      margin-bottom: 3.5rem;
    }

    .hero-trust-tag {
      font-size: 0.82rem;
      color: var(--text-dim);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }

    .hero-trust-tag span {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .hero-trust-tag i {
      color: var(--accent-emerald);
      font-size: 0.75rem;
    }

    /* Floating Stats Row in Hero */
    .hero-stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      max-width: 820px;
      margin: 0 auto;
    }

    .hero-stat-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px);
      border-radius: 14px;
      padding: 1.5rem 1rem;
      text-align: center;
      transition: var(--transition-smooth);
    }

    .hero-stat-card:hover {
      border-color: rgba(0, 168, 255, 0.3);
      transform: translateY(-4px);
    }

    .hero-stat-number {
      font-size: 2.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: 0.35rem;
      background: linear-gradient(135deg, #ffffff 40%, var(--accent-cyan) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-stat-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* ==========================================================================
       4. TRUSTED BY SECTION
       ========================================================================== */
    .trusted-by {
      padding: 60px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      background: rgba(4, 5, 8, 0.5);
    }

    .trusted-label {
      text-align: center;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 2.25rem;
    }

    .trusted-logos-grid {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
      flex-wrap: wrap;
    }

    .logo-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: rgba(255, 255, 255, 0.35);
      transition: var(--transition-smooth);
      cursor: default;
    }

    .logo-item svg, .logo-item i {
      font-size: 1.35rem;
      color: rgba(255, 255, 255, 0.35);
      transition: var(--transition-smooth);
    }

    .logo-item:hover {
      color: #ffffff;
      filter: drop-shadow(0 0 12px rgba(0, 168, 255, 0.5));
    }

    .logo-item:hover svg, .logo-item:hover i {
      color: var(--accent-cyan);
    }

    /* ==========================================================================
       5. CORE PLATFORM FEATURES (3-column grid)
       ========================================================================== */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }

    .feature-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .feature-icon-wrapper {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(0, 168, 255, 0.15) 0%, rgba(124, 58, 237, 0.15) 100%);
      border: 1px solid rgba(0, 168, 255, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      color: var(--accent-cyan);
      margin-bottom: 1.5rem;
      box-shadow: 0 8px 20px -6px rgba(0, 168, 255, 0.3);
      transition: var(--transition-smooth);
    }

    .feature-card:hover .feature-icon-wrapper {
      transform: scale(1.08);
      border-color: var(--accent-cyan);
      box-shadow: 0 0 25px rgba(0, 229, 255, 0.45);
    }

    .feature-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.85rem;
      letter-spacing: -0.01em;
    }

    .feature-desc {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }

    .feature-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .feature-tag {
      font-size: 0.72rem;
      font-family: var(--font-mono);
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.06);
      border: 1px solid rgba(0, 229, 255, 0.15);
      padding: 3px 8px;
      border-radius: 4px;
    }

    /* ==========================================================================
       6. HOW IT WORKS (3-step timeline section)
       ========================================================================== */
    .timeline-container {
      position: relative;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    /* Connector line between steps */
    .timeline-connector {
      position: absolute;
      top: 50px;
      left: 15%;
      right: 15%;
      height: 2px;
      background: linear-gradient(90deg, var(--accent-cyan) 0%, var(--accent-blue) 50%, var(--accent-purple) 100%);
      z-index: 0;
      opacity: 0.4;
    }

    .timeline-card {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
    }

    .timeline-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .step-badge {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--bg-darker);
      border: 2px solid var(--accent-blue);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      font-weight: 800;
      color: #ffffff;
      box-shadow: 0 0 20px rgba(0, 168, 255, 0.4);
    }

    .step-badge.step-2 {
      border-color: var(--accent-purple);
      box-shadow: 0 0 20px rgba(124, 58, 237, 0.4);
    }

    .step-badge.step-3 {
      border-color: var(--accent-cyan);
      box-shadow: 0 0 20px rgba(0, 229, 255, 0.4);
    }

    .step-status-chip {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 4px 10px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-muted);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .timeline-card-title {
      font-size: 1.35rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.85rem;
    }

    .timeline-card-desc {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    /* Mock Technical Visual inside Timeline Card */
    .tech-code-box {
      background: rgba(4, 5, 8, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      padding: 1rem;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      line-height: 1.5;
      color: #94a3b8;
      overflow-x: auto;
    }

    .tech-code-box .code-highlight {
      color: var(--accent-cyan);
    }

    .tech-code-box .code-purple {
      color: #c084fc;
    }

    .tech-code-box .code-green {
      color: var(--accent-emerald);
    }

    /* ==========================================================================
       7. INDUSTRY SOLUTIONS (2x2 visual grid)
       ========================================================================== */
    .solutions-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    .solution-card {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 18px;
      padding: 2.75rem;
      backdrop-filter: blur(14px);
      transition: var(--transition-smooth);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .solution-card:hover {
      transform: translateY(-6px);
      border-color: var(--border-glow);
      box-shadow: 0 20px 40px -15px rgba(0, 168, 255, 0.2);
    }

    .solution-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .solution-icon {
      font-size: 2rem;
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .solution-metric-badge {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--accent-emerald);
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.25);
      padding: 4px 12px;
      border-radius: 9999px;
    }

    .solution-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.85rem;
      letter-spacing: -0.02em;
    }

    .solution-desc {
      font-size: 0.98rem;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 1.75rem;
    }

    .solution-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--accent-cyan);
      transition: var(--transition-smooth);
    }

    .solution-link:hover {
      gap: 0.8rem;
      color: #ffffff;
      filter: drop-shadow(0 0 8px var(--accent-cyan));
    }

    /* ==========================================================================
       8. SOCIAL PROOF / METRICS SECTION (Dark with gradient bg)
       ========================================================================== */
    .metrics-section {
      background: linear-gradient(180deg, rgba(7, 8, 13, 1) 0%, rgba(15, 18, 32, 0.8) 50%, rgba(7, 8, 13, 1) 100%);
      border-top: 1px solid rgba(255, 255, 255, 0.07);
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      position: relative;
      overflow: hidden;
    }

    .metrics-section::before {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 900px;
      height: 400px;
      background: radial-gradient(ellipse, rgba(0, 168, 255, 0.15) 0%, rgba(124, 58, 237, 0.08) 50%, transparent 80%);
      filter: blur(100px);
      z-index: 0;
      pointer-events: none;
    }

    .metrics-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      text-align: center;
    }

    .metric-card {
      padding: 2rem 1.5rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      backdrop-filter: blur(10px);
      transition: var(--transition-smooth);
    }

    .metric-card:hover {
      border-color: rgba(0, 168, 255, 0.3);
      transform: translateY(-4px);
    }

    .metric-number {
      font-size: 3.5rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 0.75rem;
      background: var(--gradient-accent);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .metric-label {
      font-size: 1rem;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }

    .metric-sub {
      font-size: 0.8rem;
      color: var(--text-dim);
    }

    /* ==========================================================================
       9. TESTIMONIAL CAROUSEL
       ========================================================================== */
    .testimonial-wrapper {
      position: relative;
      max-width: 880px;
      margin: 0 auto;
    }

    .testimonial-slider {
      position: relative;
      min-height: 290px;
    }

    .testimonial-slide {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      opacity: 0;
      visibility: hidden;
      transform: scale(0.96) translateY(12px);
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .testimonial-slide.active {
      opacity: 1;
      visibility: visible;
      transform: scale(1) translateY(0);
      pointer-events: auto;
      position: relative;
    }

    .quote-icon {
      font-size: 2.25rem;
      color: var(--accent-blue);
      opacity: 0.5;
      margin-bottom: 1.25rem;
    }

    .testimonial-quote {
      font-size: 1.28rem;
      line-height: 1.6;
      color: #e2e8f0;
      font-style: normal;
      font-weight: 400;
      margin-bottom: 2rem;
    }

    .testimonial-author-box {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .author-avatar {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: linear-gradient(135deg, #00a8ff 0%, #7c3aed 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.15rem;
      color: #ffffff;
      border: 2px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 0 15px rgba(0, 168, 255, 0.3);
    }

    .author-info .author-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: #ffffff;
    }

    .author-info .author-role {
      font-size: 0.85rem;
      color: var(--accent-cyan);
    }

    .author-info .author-company {
      font-size: 0.8rem;
      color: var(--text-dim);
    }

    /* Carousel Controls */
    .carousel-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      margin-top: 2.5rem;
    }

    .carousel-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-smooth);
    }

    .carousel-btn:hover {
      background: var(--gradient-primary);
      border-color: transparent;
      box-shadow: 0 0 15px rgba(0, 168, 255, 0.4);
    }

    .carousel-dots {
      display: flex;
      gap: 0.5rem;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.2);
      transition: var(--transition-smooth);
      cursor: pointer;
    }

    .dot.active {
      width: 28px;
      background: var(--accent-cyan);
      box-shadow: 0 0 10px var(--accent-cyan);
    }

    /* ==========================================================================
       10. RESOURCE CENTER PREVIEW (Card Grid)
       ========================================================================== */
    .resources-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .resource-card {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding: 0;
    }

    .resource-thumbnail {
      width: 100%;
      height: 190px;
      position: relative;
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* CSS Gradient Art Thumbnails */
    .thumb-1 {
      background: radial-gradient(circle at 30% 30%, #1e1b4b 0%, #030712 90%);
    }

    .thumb-2 {
      background: radial-gradient(circle at 70% 30%, #082f49 0%, #020617 90%);
    }

    .thumb-3 {
      background: radial-gradient(circle at 50% 50%, #2e1065 0%, #030712 90%);
    }

    .thumb-art-svg {
      width: 120px;
      height: 120px;
      opacity: 0.85;
      filter: drop-shadow(0 0 20px rgba(0, 168, 255, 0.4));
      transition: var(--transition-smooth);
    }

    .resource-card:hover .thumb-art-svg {
      transform: scale(1.08) rotate(5deg);
    }

    .resource-tag {
      position: absolute;
      top: 1rem;
      left: 1rem;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #ffffff;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
      padding: 4px 10px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .resource-body {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .resource-meta {
      font-size: 0.78rem;
      color: var(--text-dim);
      margin-bottom: 0.65rem;
    }

    .resource-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.35;
      margin-bottom: 0.85rem;
    }

    .resource-excerpt {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.55;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }

    .resource-link {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--accent-cyan);
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: var(--transition-smooth);
    }

    .resource-link:hover {
      gap: 0.75rem;
      color: #ffffff;
    }

    /* ==========================================================================
       11. CTA BANNER SECTION
       ========================================================================== */
    .cta-section {
      padding: 100px 0;
    }

    .cta-banner {
      position: relative;
      background: linear-gradient(135deg, rgba(0, 168, 255, 0.12) 0%, rgba(124, 58, 237, 0.15) 50%, rgba(0, 229, 255, 0.08) 100%);
      border: 1px solid rgba(0, 168, 255, 0.3);
      border-radius: 24px;
      padding: 5rem 3rem;
      text-align: center;
      overflow: hidden;
      box-shadow: 0 25px 60px -20px rgba(0, 168, 255, 0.25);
    }

    .cta-banner::before {
      content: "";
      position: absolute;
      top: -50%;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 400px;
      background: radial-gradient(circle, rgba(0, 229, 255, 0.25) 0%, transparent 70%);
      filter: blur(80px);
      pointer-events: none;
    }

    .cta-headline {
      font-size: clamp(2.25rem, 4.5vw, 3.5rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #ffffff;
      margin-bottom: 1.25rem;
      position: relative;
      z-index: 1;
    }

    .cta-subtext {
      font-size: 1.15rem;
      color: #cbd5e1;
      max-width: 650px;
      margin: 0 auto 2.5rem auto;
      line-height: 1.6;
      position: relative;
      z-index: 1;
    }

    .cta-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      flex-wrap: wrap;
      position: relative;
      z-index: 1;
    }

    /* ==========================================================================
       12. FOOTER (Multi-column)
       ========================================================================== */
    .footer {
      background: #030407;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 90px 0 40px 0;
      position: relative;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 4rem;
    }

    .footer-brand .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.35rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 1rem;
    }

    .footer-brand .brand-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 1.75rem;
      max-width: 320px;
    }

    .social-links {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .social-link {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      transition: var(--transition-smooth);
    }

    .social-link:hover {
      background: rgba(0, 168, 255, 0.15);
      border-color: var(--accent-blue);
      color: var(--accent-cyan);
      transform: translateY(-2px);
    }

    .footer-column .column-title {
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #ffffff;
      margin-bottom: 1.5rem;
    }

    .footer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .footer-link {
      font-size: 0.9rem;
      color: var(--text-muted);
      transition: var(--transition-smooth);
    }

    .footer-link:hover {
      color: var(--accent-cyan);
      transform: translateX(3px);
    }

    /* System Status indicator in footer */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 5px 12px;
      border-radius: 9999px;
      margin-top: 1.5rem;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent-emerald);
      box-shadow: 0 0 8px var(--accent-emerald);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.85); }
    }

    /* Footer Bottom Bar */
    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.5rem;
      font-size: 0.82rem;
      color: var(--text-dim);
    }

    .footer-legal-links {
      display: flex;
      gap: 1.75rem;
    }

    .footer-legal-link:hover {
      color: var(--text-muted);
    }

    /* ==========================================================================
       13. INTERACTIVE MODAL (Request a Demo)
       ========================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(16px);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }

    .modal-backdrop.active {
      opacity: 1;
      visibility: visible;
    }

    .modal-dialog {
      background: #0d0f1a;
      border: 1px solid rgba(0, 168, 255, 0.3);
      border-radius: 20px;
      max-width: 580px;
      width: 100%;
      padding: 2.75rem;
      position: relative;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(0, 168, 255, 0.15);
      transform: scale(0.95) translateY(20px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .modal-backdrop.active .modal-dialog {
      transform: scale(1) translateY(0);
    }

    .modal-close-btn {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition-smooth);
    }

    .modal-close-btn:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.15);
    }

    .modal-title {
      font-size: 1.75rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }

    .modal-sub {
      font-size: 0.92rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }

    .demo-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .form-group-full {
      grid-column: span 2;
    }

    .form-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.45rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .form-input, .form-select {
      width: 100%;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-family: inherit;
      font-size: 0.92rem;
      color: #ffffff;
      transition: var(--transition-smooth);
    }

    .form-input:focus, .form-select:focus {
      outline: none;
      border-color: var(--accent-cyan);
      box-shadow: 0 0 15px rgba(0, 229, 255, 0.25);
      background: rgba(255, 255, 255, 0.07);
    }

    .form-select option {
      background: #0d0f1a;
      color: #ffffff;
    }

    .form-submit-btn {
      width: 100%;
      margin-top: 0.75rem;
      padding: 0.95rem;
    }

    /* Toast Notification */
    .toast-notification {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #0b0e1b;
      border: 1px solid var(--accent-cyan);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 229, 255, 0.3);
      padding: 1rem 1.5rem;
      border-radius: 12px;
      z-index: 3000;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      color: #ffffff;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .toast-notification.show {
      transform: translateY(0);
      opacity: 1;
    }

    .toast-icon {
      color: var(--accent-emerald);
      font-size: 1.25rem;
    }

    /* ==========================================================================
       14. RESPONSIVE DESIGN (Media Queries)
       ========================================================================== */
    @media (max-width: 1080px) {
      .features-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .footer-grid {
        grid-template-columns: 2fr 1fr 1fr;
      }
    }

    @media (max-width: 900px) {
      .nav-links, .nav-signin {
        display: none;
      }
      .mobile-toggle {
        display: flex;
      }
      .mobile-drawer {
        display: block;
      }
      .timeline-container {
        grid-template-columns: 1fr;
      }
      .timeline-connector {
        display: none;
      }
      .solutions-grid {
        grid-template-columns: 1fr;
      }
      .resources-grid {
        grid-template-columns: 1fr;
      }
      .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .hero-stats-row {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .section {
        padding: 70px 0;
      }
      .features-grid {
        grid-template-columns: 1fr;
      }
      .metrics-grid {
        grid-template-columns: 1fr;
      }
      .footer-grid {
        grid-template-columns: 1fr;
      }
      .cta-banner {
        padding: 3.5rem 1.5rem;
      }
      .demo-form {
        grid-template-columns: 1fr;
      }
      .form-group-full {
        grid-column: span 1;
      }
    }
  </style>
</head>
<body>

  <!-- Ambient Lattice Grid Mask Background -->
  <div class="bg-grid-pattern"></div>

  <!-- ==========================================================================
       1. NAVIGATION BAR
       ========================================================================== -->
  <header class="navbar" id="navbar">
    <div class="container nav-container">
      <!-- Logo -->
      <a href="#" class="nav-logo" aria-label="MetaLattice Homepage">
        <!-- High-tech Lattice SVG Icon -->
        <svg class="logo-icon-svg" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="18,3 32,10 32,26 18,33 4,26 4,10" stroke="url(#logo-grad-1)" stroke-width="2.2" fill="none" opacity="0.8"/>
          <line x1="18" y1="3" x2="18" y2="33" stroke="url(#logo-grad-2)" stroke-width="1.8" stroke-dasharray="2 2"/>
