  <section class="section" id="features">
    <div class="container">
      <div class="section-header fade-in-element">
        <div class="eyebrow">
          <i class="fa-solid fa-microchip"></i>
          Uncompromising Computational Core
        </div>
        <h2 class="section-title">Engineered for Extreme Complexity</h2>
        <p class="section-subtitle">
          Traditional CAD breaks when geometries scale to millions of faces. MetaLattice operates directly on mathematical implicit fields, enabling unlimited complexity without crashing.
        </p>
      </div>

      <div class="features-grid">
        <!-- Feature 1: Implicit Modeling -->
        <div class="glass-card feature-card fade-in-element">
          <div>
            <div class="feature-icon-wrapper">
              <i class="fa-solid fa-cube"></i>
            </div>
            <h3 class="feature-title">Implicit Modeling</h3>
            <p class="feature-desc">
              Design without geometric fragility. MetaLattice's field-driven geometry eliminates mesh failures, filleting crashes, and constraint conflicts forever.
            </p>
          </div>
          <div class="feature-tags">
            <span class="feature-tag">Zero Boolean Errors</span>
            <span class="feature-tag">Infinite Resolution</span>
            <span class="feature-tag">Signed Distance Fields</span>
          </div>
        </div>

        <!-- Feature 2: Physics AI -->
        <div class="glass-card feature-card fade-in-element">
          <div>
            <div class="feature-icon-wrapper">
              <i class="fa-solid fa-brain"></i>
            </div>
            <h3 class="feature-title">Physics AI</h3>
            <p class="feature-desc">
              Simulate thousands of design variants with embedded physics feedback — no manual FEA handoffs or mesh generation bottlenecks required.
            </p>
          </div>
          <div class="feature-tags">
            <span class="feature-tag">Surrogate Solvers</span>
            <span class="feature-tag">Real-Time Stress</span>
            <span class="feature-tag">Thermal Conduction</span>
          </div>
        </div>

        <!-- Feature 3: Design Automation -->
        <div class="glass-card feature-card fade-in-element">
          <div>
            <div class="feature-icon-wrapper">
              <i class="fa-solid fa-diagram-project"></i>
            </div>
            <h3 class="feature-title">Design Automation</h3>
            <p class="feature-desc">
              Encode engineering logic once. Deploy reusable computational workflows across programs, teams, and supply chains via headless execution.
            </p>
          </div>
          <div class="feature-tags">
            <span class="feature-tag">Python & C++ API</span>
            <span class="feature-tag">Headless CLI</span>
            <span class="feature-tag">CI/CD Cad Pipelines</span>
          </div>
        </div>

        <!-- Feature 4: Lattice Structures -->
        <div class="glass-card feature-card fade-in-element">
          <div>
            <div class="feature-icon-wrapper">
              <i class="fa-solid fa-network-wired"></i>
            </div>
            <h3 class="feature-title">Lattice Structures</h3>
            <p class="feature-desc">
              Generate optimized lattice, TPMS, and infill structures for additive manufacturing with a single command and smooth thickness gradients.
            </p>
          </div>
          <div class="feature-tags">
            <span class="feature-tag">Gyroid & Schwarz TPMS</span>
            <span class="feature-tag">Conformal Infill</span>
            <span class="feature-tag">Stress-Aligned Struts</span>
          </div>
        </div>

        <!-- Feature 5: Multi-Solver Integration -->
        <div class="glass-card feature-card fade-in-element">
          <div>
            <div class="feature-icon-wrapper">
              <i class="fa-solid fa-arrows-split-up-and-left"></i>
            </div>
            <h3 class="feature-title">Multi-Solver Integration</h3>
            <p class="feature-desc">
              Connect natively to ANSYS, Abaqus, OpenFOAM, and NASTRAN for closed-loop multi-objective optimization and verification.
            </p>
          </div>
          <div class="feature-tags">
            <span class="feature-tag">Native ANSYS / Abaqus</span>
            <span class="feature-tag">OpenFOAM Bridge</span>
            <span class="feature-tag">Direct B-Rep / STEP</span>
          </div>
        </div>

        <!-- Feature 6: Cloud Scale -->
        <div class="glass-card feature-card fade-in-element">
          <div>
            <div class="feature-icon-wrapper">
              <i class="fa-solid fa-cloud-bolt"></i>
            </div>
            <h3 class="feature-title">Cloud Scale</h3>
            <p class="feature-desc">
              Run parametric sweeps across thousands of design instances concurrently on MetaLattice Cloud without HPC overhead or queue bottlenecks.
            </p>
          </div>
          <div class="feature-tags">
            <span class="feature-tag">Parallel GPU Clusters</span>
            <span class="feature-tag">Automated Pareto Sets</span>
            <span class="feature-tag">Team Collaboration</span>
          </div>
        </div>
